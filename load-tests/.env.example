# Copia a .env local y exporta las variables con tu herramienta preferida. Este archivo no contiene secretos.
TARGET_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=public-anon-key-from-the-isolated-environment
LOADTEST_ALLOW_HOSTS=127.0.0.1,localhost
PROFILE=smoke
SCALE=1
MAX_VUS=2000
THINK_SCALE=1

# Opcionales, solo para 01-static.js. Deben ser sitios de prueba autorizados.
NETLIFY_URL=http://127.0.0.1:4173
INSTITUTIONAL_URL=

# NO habilitar por defecto. La frase exacta se documenta en README.md.
LOADTEST_ALLOW_WRITES=
LOADTEST_THIRD_PARTY_AUTHORIZATION=
